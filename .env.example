# ── Database ──────────────────────────────────────────────────────────
# Production: PostgreSQL (Neon / any Postgres)
# App runtime can use the pooled URL; `npm run db:migrate` must use the
# direct (non-pooled) URL — remove "-pooler" from the Neon host.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
#
# Local development: SQLite (default schema.prisma)
# DATABASE_URL="file:./dev.db"
DATABASE_URL=""

# ── Auth ──────────────────────────────────────────────────────────────
# REQUIRED in every environment. Signs the admin session cookie.
# Generate with: openssl rand -base64 32
# Rotating this value logs every admin out (intended).
AUTH_SECRET=""

# ── Optional market data ──────────────────────────────────────────────
# CoinGecko demo key, raises the public rate limit. Falls back to other
# sources when empty.
COINGECKO_API_KEY=""

# Google Search Console verification code (the content value of the meta tag)
GOOGLE_SITE_VERIFICATION=""

# ── Seed / admin bootstrap (only used by scripts, not at runtime) ─────
# Required by `npm run seed` to create the first admin; the seed refuses to
# create an account with a hard-coded default password.
ADMIN_EMAIL="admin@bqzn.top"
ADMIN_PASSWORD=""

# ── Media library (S3-compatible: Cloudflare R2 / AWS S3 / MinIO) ─────
# Required in production. When empty, local dev writes to public/uploads.
# R2: endpoint https://<account>.r2.cloudflarestorage.com, region "auto".
# S3: endpoint https://s3.<region>.amazonaws.com, region <region>.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="https://cdn.bqzn.top"
S3_REGION="auto"
