generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Exchange {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  logo           String?
  description    String?
  content        String?
  rating         Float     @default(0)
  referralUrl    String?
  feeRate        String?
  spotFee        String?
  futuresFee     String?
  features       String?
  supportedCoins String?
  regulation     String?
  inviteCode     String?
  status         String    @default("active") // active, inactive
  sortOrder      Int       @default(0)
  isFeatured     Boolean   @default(false)
  isPopular      Boolean   @default(false)
  clickCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])

  @@index([status, sortOrder, clickCount])
  @@index([status, categoryId, sortOrder, clickCount])
  @@index([categoryId])
}

model Article {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  excerpt     String?
  content     String?
  coverImage  String?
  author      String?
  published   Boolean        @default(false)
  publishedAt DateTime?
  clickCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  tags        TagOnArticle[]

  @@index([published, publishedAt])
  @@index([published, categoryId, publishedAt])
  @@index([categoryId])
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  type        String     @default("exchange") // exchange, article
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  exchanges   Exchange[]
  articles    Article[]

  @@index([type, sortOrder])
}

model Tag {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  articles  TagOnArticle[]
}

model TagOnArticle {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("通用")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder, createdAt])
  @@index([published])
}

model ClickLog {
  id         String   @id @default(cuid())
  targetId   String // exchange or article id
  targetType String // "exchange" or "article"
  ip         String?
  userAgent  String?
  referer    String?
  country    String?
  createdAt  DateTime @default(now())

  @@index([targetId, targetType])
  @@index([targetType, targetId, createdAt])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Media {
  id        String       @id @default(cuid())
  filename  String
  url       String
  type      String // image/jpeg, image/png, image/webp, etc.
  size      Int // file size in bytes
  alt       String?
  sortOrder Int          @default(0)
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  media     Media[]
}

model Resource {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?
  content       String?
  category      String   @default("newbie") // newbie, template, tool, link
  type          String   @default("file") // page, file, external
  fileUrl       String?
  fileSize      String?
  externalUrl   String?
  icon          String?
  tags          String?
  downloadCount Int      @default(0)
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HomeSection {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  type      String   @default("exchanges") // exchanges, articles, featured
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
